# ---- IORT v3.1.0 runtime configuration. Copy to .env; never commit .env. ----
APP_ENV=production
DATABASE_URL=postgresql+psycopg://iort:CHANGE_ME@postgres:5432/iort
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=CHANGE_ME
DATA_DIR=/app/data

# ---- Live switches (all default to safe) ----
LIVE_TRADING=false
LIVE_PRODUCTION_ACK=                      # must be I_UNDERSTAND_REAL_ORDERS for live
AUTO_TRADING_ENABLED=false                # no automatic order generator exists in this build
REQUIRE_HUMAN_APPROVAL_AUTO=true
REQUIRE_OPERATOR_AUTH=true
OPERATOR_API_TOKEN=                       # >= 24 random characters; required for live and for control actions
AUDIT_HMAC_KEY=                           # required for live; keyed audit chain (keep outside the database host)
ALLOWED_ORIGINS=                          # extra browser origins allowed to POST (same-host is always allowed)

# ---- Evidence requirements ----
REQUIRE_DURABLE_EVENT_BUS=true
REQUIRE_MARGIN_EVIDENCE=true
REQUIRE_INSTRUMENT_MASTER=true            # instrument master must be loaded TODAY for the target broker
REQUIRE_AUTHORITATIVE_DAILY_PNL=true      # true: only broker-native day P&L (Zerodha m2m) is accepted
REQUIRE_LIVE_LTP_FOR_EXPOSURE=true        # every open position's token must be in SUBSCRIPTION_JSON
REQUIRE_SCENARIO_RISK=false               # true needs UNDERLYING_SPOT_TOKENS_JSON
REQUIRE_BROKER_ORDER_MARGIN=false         # true: block when the broker margin API is unavailable (only Zerodha wired)

# ---- Market data ----
DATA_STALE_MS=1500
MAX_CLOCK_SKEW_MS=2000                    # keep the host on NTP
STREAM_STALL_SEC=30
SUBSCRIPTION_JSON={}                      # {"ZERODHA":[256265,...],"UPSTOX":["NSE_FO|..."],"ANGEL":["NFO|..."],"KOTAK":["nse_fo|48201","nse_cm|Nifty 50"]}
# Kotak indices stream by name on nse_cm/bse_cm ("nse_cm|Nifty 50", "nse_cm|Nifty Bank", "bse_cm|SENSEX") and become the option chain spot.
KOTAK_INDEX_UNDERLYINGS_JSON={}           # extra index-name -> underlying mappings, e.g. {"Nifty IT":"NIFTYIT"}
KOTAK_AUTO_CHAIN_JSON={}                  # strikes kept subscribed around spot, e.g. {"NIFTY":{"expiries":2,"strikes":15}}
KOTAK_AUTO_CHAIN_INTERVAL_SEC=30          # how often the strike window is re-centred
KOTAK_AUTO_CHAIN_MAX_TOKENS=1000          # cap on auto-subscribed tokens (open positions are always kept first)
INSTRUMENT_MASTER_URLS_JSON={}            # {"ZERODHA":"https://api.kite.trade/instruments", ...} loaded at startup
UNDERLYING_SPOT_TOKENS_JSON={}            # {"NIFTY":{"ZERODHA":"256265","ANGEL":"26000"}}
KOTAK_INSTRUMENT_MASTER_AUTO=true         # fetch Kotak's dated scrip master automatically (consumer key only, no login)
KOTAK_SCRIP_SEGMENTS=nse_cm,nse_fo,bse_fo,mcx_fo  # segments loaded together into the KOTAK index
INSTRUMENT_REFRESH_CHECK_SEC=300          # how often the loader checks whether today's files are loaded
INSTRUMENT_REFRESH_AFTER_IST=08:30        # fixed-URL masters (Zerodha/Angel/Upstox) reload once a day after this IST time

# ---- Portfolio limits (firm level, INR) ----
PORTFOLIO_SOFT_SL=2000
PORTFOLIO_HARD_SL=4000                    # breach -> persisted kill + cancel all (+ flatten if enabled)
MAX_DAILY_LOSS=4000                       # breach -> persisted kill
MAX_MARGIN_UTILIZATION_PCT=70             # checked post-trade
MAX_NET_EXPOSURE=1000000                  # gross premium exposure incl. this order
MAX_SHORT_OPTION_NOTIONAL=2500000         # sum of strike x qty for short options
MAX_POSITION_QTY=1000                     # per instrument, incl. working orders
MAX_ORDER_VALUE=500000
MAX_SLIPPAGE_BPS=50                       # max bid/ask spread
MAX_PRICE_DEVIATION_BPS=500               # limit-price collar vs LTP
MAX_SCENARIO_LOSS=1000000
SHORT_OPTION_MARGIN_PCT=18                # margin estimate when the broker margin API is not wired
MAX_ORDERS_PER_SECOND=5
RISK_FREE_RATE=0.065

# ---- Order policy ----
ALLOW_MARKET_ORDERS=false
ALLOW_NAKED_SHORT_OPTIONS=false           # false: each short option needs a same-type, same-expiry long hedge
AI_GATE_MODE=VETO_CONTRADICTION           # ADVISORY | VETO_CONTRADICTION | REQUIRE_AGREEMENT
AI_WINDOW_SEC=60
SMART_ROUTING_ENABLED=true
ROUTING_BROKERS=ZERODHA,KOTAK,UPSTOX,ANGEL

# ---- Control loops ----
WATCHDOG_TIMEOUT_SEC=5
ORDER_RECONCILE_INTERVAL_SEC=2
RECONCILE_INTERVAL_SEC=30
RISK_MONITOR_INTERVAL_SEC=2
RISK_SNAPSHOT_MAX_AGE_SEC=10
RECONCILIATION_MAX_AGE_SEC=60
BROKER_HEALTH_TTL_SEC=10
EMERGENCY_FLATTEN_ENABLED=true
AUTO_FLATTEN_ON_HARD_STOP=false
FLATTEN_LIMIT_SLIPPAGE_BPS=300

# ---- Broker credentials (runtime only) ----
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_API_KEY=
ANGEL_ACCESS_TOKEN=
ANGEL_CLIENT_CODE=
ANGEL_FEED_TOKEN=
KOTAK_API_KEY=
KOTAK_CLIENT_CODE=
KOTAK_MOBILE=
KOTAK_MPIN=
KOTAK_TOTP_SECRET=                        # base32 secret; lets the terminal re-login (KOTAK_TOTP works once)
KOTAK_TOTP=
KOTAK_SESSION_TTL_SEC=21600
KOTAK_LOGIN_BACKOFF_SEC=30                # failed login waits 30, 60, 120 ... seconds before the next attempt
KOTAK_LOGIN_BACKOFF_MAX_SEC=900           # backoff cap
KOTAK_LOGIN_MAX_REJECTIONS=2              # consecutive wrong-credential rejections before auto-login halts (operator reset)
