# =====================================================================================
# IORT 3.3.1 runtime configuration. Copy this file to .env and fill section 1.
# .env is listed in .gitignore: never commit it, never paste its values into chat or email.
# A value set in the process environment (or the Windows installer) overrides this file.
# =====================================================================================

# -------------------------------------------------------------------------------------
# 1. KOTAK NEO LOGIN  (fill these on your own PC; the terminal logs in by itself)
# -------------------------------------------------------------------------------------
# Consumer key from Kotak Neo > Invest > Trade API (the app you created there).
KOTAK_API_KEY=
# Mobile number registered with Kotak, with country code: +919876543210
KOTAK_MOBILE=
# Kotak client code (UCC), for example AB1234
KOTAK_CLIENT_CODE=
# The 6-digit MPIN you use in the Kotak Neo app
KOTAK_MPIN=
# TOTP secret: the base32 text behind the QR code shown when you register TOTP for the Trade API
# (letters A-Z and digits 2-7, spaces allowed). With it the terminal re-logs in by itself every day,
# after a session expiry and after a reconnect. Keep the PC clock synced (Windows: Settings > Time > Sync now).
KOTAK_TOTP_SECRET=
# Only for a single manual test: a one-time 6-digit code instead of the secret. It works for one login,
# so the terminal cannot log in again by itself with it. Leave empty and use KOTAK_TOTP_SECRET.
KOTAK_TOTP=

# Session upkeep: a trading day starts at the pre-open login (KOTAK_PRELOGIN_IST, weekdays). A session lasts
# until the next pre-open (Friday's lasts the weekend) and is replaced at once if Kotak ends it (the call is
# then retried once). No login happens at midnight. '' turns the pre-open login off (the day then starts at
# midnight). The TTL is only a backstop and must exceed a weekend.
KOTAK_SESSION_TTL_SEC=288000
KOTAK_PRELOGIN_IST=08:50
# Failed calls in a row treated as a silent session expiry
KOTAK_RELOGIN_AFTER_ERRORS=3
# Automatic re-logins allowed per 15 minutes (stops login storms)
KOTAK_RELOGIN_BUDGET=4
# Lockout protection: failed logins wait 30, 60, 120 ... s (cap 900 s). Two wrong-credential rejections in a row
# halt automatic login until you fix the credentials and press Reset KOTAK login (Overview tab).
KOTAK_LOGIN_BACKOFF_SEC=30
KOTAK_LOGIN_BACKOFF_MAX_SEC=900
KOTAK_LOGIN_MAX_REJECTIONS=2
# Network, gateway and Kotak maintenance failures never reach the credential check: they retry after
# 5, 10, 20, 40 s (cap 60 s) and never count toward the halt.
KOTAK_LOGIN_TRANSPORT_BACKOFF_SEC=5
KOTAK_LOGIN_TRANSPORT_BACKOFF_MAX_SEC=60
KOTAK_LOGIN_STEP_TIMEOUT_SEC=20

# -------------------------------------------------------------------------------------
# 2. KOTAK LIVE MARKET DATA  (the terminal shows only live data; with none it shows blank)
# -------------------------------------------------------------------------------------
# Instruments streamed from start. Indices by name on a cash segment become the option chain's live spot.
# JSON values keep their single quotes here; as a Windows or cloud environment variable they work with or without them.
# NSE cash tokens: RELIANCE 2885, TCS 11536, INFY 1594, HDFCBANK 1333, ICICIBANK 4963, SBIN 3045.
SUBSCRIPTION_JSON='{"KOTAK":["nse_cm|Nifty 50","nse_cm|Nifty Bank","bse_cm|SENSEX"]}'
# Option strikes kept subscribed around spot: nearest N expiries, ATM +/- M strikes, CE and PE, re-centred every 30 s.
KOTAK_AUTO_CHAIN_JSON='{"NIFTY":{"expiries":2,"strikes":15},"BANKNIFTY":{"expiries":1,"strikes":15}}'
KOTAK_AUTO_CHAIN_INTERVAL_SEC=30
# Open positions are always kept first
KOTAK_AUTO_CHAIN_MAX_TOKENS=1000
# Extra index-name -> underlying, e.g. {"Nifty IT":"NIFTYIT"}
KOTAK_INDEX_UNDERLYINGS_JSON={}
# Optional, e.g. {"NIFTY":{"KOTAK":"Nifty 50"}}
UNDERLYING_SPOT_TOKENS_JSON={}
# Kotak's dated scrip master is found and loaded every day (consumer key only, no login).
KOTAK_INSTRUMENT_MASTER_AUTO=true
KOTAK_SCRIP_SEGMENTS=nse_cm,nse_fo,bse_fo,mcx_fo
INSTRUMENT_REFRESH_CHECK_SEC=300
# Fixed-URL masters of other brokers reload after this time
INSTRUMENT_REFRESH_AFTER_IST=08:30
INSTRUMENT_MASTER_URLS_JSON={}
# A quote older than this is not live: orders refuse it, the screen blanks it
DATA_STALE_MS=1500
MAX_CLOCK_SKEW_MS=2000
STREAM_STALL_SEC=30

# -------------------------------------------------------------------------------------
# 3. FEED RECONNECT  (Market tab: Reconnect now, Auto on/off)
# -------------------------------------------------------------------------------------
# A dropped feed reconnects at once, then after 1, 2, 5, 10 and 20 s, capped at STREAM_RECONNECT_MAX_SEC.
STREAM_AUTO_RECONNECT=true
STREAM_RECONNECT_MAX_SEC=30
# A connection up this long resets the backoff
STREAM_HEALTHY_RESET_SEC=30
# Failed reconnects before a fresh Kotak login is forced
STREAM_RELOGIN_AFTER_FAILURES=3
# Silence during market hours that counts as a dead feed
KOTAK_STREAM_STALL_SEC=15

# -------------------------------------------------------------------------------------
# 4. TERMINAL SECURITY AND INFRASTRUCTURE  (the Windows installer generates these)
# -------------------------------------------------------------------------------------
# Random; must match DATABASE_URL
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://iort:CHANGE_ME@postgres:5432/iort
REDIS_URL=redis://redis:6379/0
DATA_DIR=/app/data
# Operator token: paste it into the Execution tab for control actions (reconnect, kill reset, cancel).
# >= 24 random characters
OPERATOR_API_TOKEN=
# Keyed audit chain; required when order routing is live
AUDIT_HMAC_KEY=
REQUIRE_OPERATOR_AUTH=true
OPERATOR_TOKEN_MIN_LENGTH=24
AUDIT_CHAIN_REQUIRED=true
# Extra browser origins allowed to POST (same host is always allowed)
ALLOWED_ORIGINS=
# Kotak accepts API orders only from the static public IP registered with it (data needs no static IP).
# The public IP you registered with Kotak, e.g. 203.0.113.7
REGISTERED_STATIC_IP=
# With live order routing, block orders unless this PC's public IP matches
REQUIRE_STATIC_IP_MATCH=true
PUBLIC_IP_URL=https://api.ipify.org

# -------------------------------------------------------------------------------------
# 5. ORDER ROUTING INTERLOCK  (LOCKED until the controlled live test passes)
# -------------------------------------------------------------------------------------
# false = every order is refused before any broker. Data is live either way.
LIVE_TRADING=false
# Must be I_UNDERSTAND_REAL_ORDERS for live order routing
LIVE_PRODUCTION_ACK=
# No automatic order generator exists in this build
AUTO_TRADING_ENABLED=false
REQUIRE_HUMAN_APPROVAL_AUTO=true

# -------------------------------------------------------------------------------------
# 6. EVIDENCE REQUIREMENTS  (fail closed: missing evidence blocks orders)
# -------------------------------------------------------------------------------------
REQUIRE_DURABLE_EVENT_BUS=true
REQUIRE_MARGIN_EVIDENCE=true
# The master must be loaded today for the target broker
REQUIRE_INSTRUMENT_MASTER=true
REQUIRE_AUTHORITATIVE_DAILY_PNL=true
REQUIRE_LIVE_LTP_FOR_EXPOSURE=true
REQUIRE_SCENARIO_RISK=false
REQUIRE_BROKER_ORDER_MARGIN=false

# -------------------------------------------------------------------------------------
# 7. RISK LIMITS  (firm level, INR)
# -------------------------------------------------------------------------------------
PORTFOLIO_SOFT_SL=2000
# Breach -> persisted kill + cancel all
PORTFOLIO_HARD_SL=4000
MAX_DAILY_LOSS=4000
MAX_MARGIN_UTILIZATION_PCT=70
MAX_NET_EXPOSURE=1000000
MAX_SHORT_OPTION_NOTIONAL=2500000
MAX_POSITION_QTY=1000
MAX_ORDER_VALUE=500000
MAX_SLIPPAGE_BPS=50
MAX_PRICE_DEVIATION_BPS=500
MAX_SCENARIO_LOSS=1000000
MAX_ABS_DELTA=1000000
MAX_ABS_VEGA=1000000
# Margin estimate while the broker margin API is not wired
SHORT_OPTION_MARGIN_PCT=18
MAX_ORDERS_PER_SECOND=5
RISK_FREE_RATE=0.065

# -------------------------------------------------------------------------------------
# 8. ORDER POLICY
# -------------------------------------------------------------------------------------
ALLOW_MARKET_ORDERS=false
# Each short option needs a same-type, same-expiry long hedge
ALLOW_NAKED_SHORT_OPTIONS=false
AI_GATE_MODE=VETO_CONTRADICTION
AI_WINDOW_SEC=60
SMART_ROUTING_ENABLED=true
ROUTING_BROKERS=KOTAK

# -------------------------------------------------------------------------------------
# 9. CONTROL LOOPS
# -------------------------------------------------------------------------------------
WATCHDOG_TIMEOUT_SEC=5
ORDER_RECONCILE_INTERVAL_SEC=2
RECONCILE_INTERVAL_SEC=30
RISK_MONITOR_INTERVAL_SEC=2
RISK_SNAPSHOT_MAX_AGE_SEC=10
RECONCILIATION_MAX_AGE_SEC=60
BROKER_HEALTH_TTL_SEC=10
EMERGENCY_FLATTEN_ENABLED=true
AUTO_FLATTEN_ON_HARD_STOP=false
FLATTEN_LIMIT_SLIPPAGE_BPS=300

# -------------------------------------------------------------------------------------
# 10. OTHER BROKERS  (not used with Kotak; leave empty)
# -------------------------------------------------------------------------------------
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
UPSTOX_ACCESS_TOKEN=
ANGEL_API_KEY=
ANGEL_ACCESS_TOKEN=
ANGEL_CLIENT_CODE=
ANGEL_FEED_TOKEN=
